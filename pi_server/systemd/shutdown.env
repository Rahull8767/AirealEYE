# ==============================================================================
# AerialEYE Shutdown Daemon Environment Configuration
# File: /etc/aerialeye/shutdown.env
# Secure permissions: sudo chmod 600 /etc/aerialeye/shutdown.env
# ==============================================================================

# Authentication token required by the mobile app to execute shutdown.
# Replace this with your own strong private secret token before flight!
AERIALEYE_SHUTDOWN_TOKEN="aerialeye-safe-shutdown-secret-2026"
